<?xml version="1.0" encoding="UTF-8"?>
<policyconfig>
  <vendor>Tab Companion</vendor>
  <action id="io.github.agcarbajo.TabCompanion.power-profile">
    <description>Change the tablet power profile</description>
    <message>Authentication is required to change the power profile</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/tab-companion-power-profile</annotate>
  </action>
</policyconfig>
