<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/PolicyConfiguration.dtd">
<policyconfig>
  <vendor>Tab Companion for Galaxy Tab S9+ SM-X810</vendor>
  <action id="io.github.agcarbajo.TabCompanion.X810.boot-noask">
    <description>Change whether boot switching asks for authentication</description>
    <message>Authentication is required to change the boot-switch password setting</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/tab-companion-boot-noask</annotate>
  </action>
</policyconfig>
