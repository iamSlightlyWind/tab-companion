#!/usr/bin/python3
"""Tab Companion Fedora/X810 backend: write only the 4 boot-set partitions."""
import json
import os
import pathlib
import subprocess
import sys

BASE = pathlib.Path('/var/lib/x810-boot-sets')
PARTS = {'boot': 100663296, 'init_boot': 8388608,
         'vendor_boot': 100663296, 'dtbo': 16777216}
BLOCKS = pathlib.Path('/dev/disk/by-partlabel')
EXPECTED = {
    'boot': '/dev/sda21', 'init_boot': '/dev/sda22',
    'vendor_boot': '/dev/sda24', 'dtbo': '/dev/sda30',
}

def emit(message):
    print(message, flush=True)

def device_path(part):
    p = BLOCKS / part
    if not p.exists() or os.path.realpath(p) != EXPECTED[part]:
        raise RuntimeError(f'{part}: unexpected/missing by-partlabel device')
    actual = subprocess.check_output(['blockdev', '--getsize64', str(p)], text=True).strip()
    if int(actual) != PARTS[part]:
        raise RuntimeError(f'{part}: partition is {actual} bytes, expected {PARTS[part]}')
    return p

def validate_device():
    try:
        model = pathlib.Path('/proc/device-tree/model').read_bytes().rstrip(b'\0').decode()
    except OSError:
        model = ''
    if 'GTS9PWIFI' not in model:
        raise RuntimeError(f'Not the expected SM-X810-family board ({model or "unknown model"})')
    root = subprocess.check_output(['findmnt', '-n', '-o', 'SOURCE', '/'], text=True).strip()
    if os.path.realpath(root) != '/dev/sda35':
        raise RuntimeError(f'Linux root is {root}, not the expected linuxroot /dev/sda35')
    for p in PARTS:
        device_path(p)

def validate_images(name):
    """Check image presence and partition-sized length, not fixed fingerprints.

    Android boot images are commonly changed by Magisk, custom kernels, and
    recovery repacking. Those user-selected bytes must not be rejected because
    they differ from a stale SHA-256 recorded when the set was first staged.
    """
    for part, size in PARTS.items():
        image = BASE / name / f'{part}.img'
        if not image.is_file() or image.stat().st_size != size:
            raise RuntimeError(f'{name}/{part}: missing or wrong-size image')
    return True

def read_os_release_id():
    try:
        for line in pathlib.Path('/etc/os-release').read_text(encoding='utf-8').splitlines():
            if line.startswith('ID='):
                return line.partition('=')[2].strip().strip('"').lower()
    except OSError:
        pass
    return ''

def current_system():
    """Identify the running OS without hashing boot partitions.

    This backend is for the Fedora X810 port. validate_device() independently
    requires its dedicated linuxroot partition, so a recognized Fedora ID is
    sufficient and does not depend on saved images or a manifest.
    """
    return 'fedora' if read_os_release_id() == 'fedora' else 'mixed/unknown'

def same_bytes(source, target, size):
    """Verify a completed raw write by direct comparison, without a digest."""
    with open(source, 'rb', buffering=0) as src, open(target, 'rb', buffering=0) as dst:
        remaining = size
        while remaining:
            count = min(4 * 1024 * 1024, remaining)
            left, right = src.read(count), dst.read(count)
            if len(left) != count or len(right) != count or left != right:
                return False
            remaining -= count
        return not src.read(1)

def status():
    ready = {}
    errors = {}
    for name in ('fedora', 'android'):
        try:
            validate_images(name)
            ready[name] = True
        except Exception as error:
            ready[name] = False
            errors[name] = str(error)
    print(json.dumps({'current': current_system(), 'ready': ready,
                      'errors': errors}, sort_keys=True))

def stage(name):
    if name not in ('fedora', 'android'):
        raise RuntimeError('Choose android or fedora')
    validate_device()
    validate_images(name)
    for part, size in PARTS.items():
        image = BASE / name / f'{part}.img'
        dest = device_path(part)
        emit(f'Writing and checking {part}…')
        with open(image, 'rb', buffering=0) as src, open(dest, 'wb', buffering=0) as out:
            while True:
                block = src.read(4 * 1024 * 1024)
                if not block:
                    break
                out.write(block)
            out.flush()
            os.fsync(out.fileno())
        os.sync()
        if not same_bytes(image, dest, size):
            raise RuntimeError(f'{part}: read-back differs from the selected image. Do NOT reboot; stage Fedora again.')
        emit(f'{part}: verified')
    emit(f'Complete: {name} boot set staged. Tablet was NOT rebooted.')

def main():
    if os.geteuid() != 0:
        raise SystemExit('Run through pkexec; root is required for raw partition reads/writes.')
    try:
        if len(sys.argv) == 2 and sys.argv[1] == 'status':
            validate_device(); status()
        elif len(sys.argv) == 3 and sys.argv[1] == 'stage':
            stage(sys.argv[2])
        else:
            raise RuntimeError('Usage: tab-companion-boot-switch status | stage android|fedora')
    except Exception as e:
        emit(f'ERROR: {e}')
        return 1
    return 0

if __name__ == '__main__':
    sys.exit(main())
