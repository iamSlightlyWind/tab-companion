"""Persist bounded per-profile CPU/GPU performance settings."""

from __future__ import annotations

import json
import os
import sys
import tempfile
from pathlib import Path

CONFIG = Path("/etc/x810-power-profile-tuning.json")
PROFILE_IDS = ("power-saver", "balanced", "performance")


def valid_settings(value: object) -> bool:
    if (not isinstance(value, dict) or set(value) != {"version", "profiles"}
            or type(value["version"]) is not int or value["version"] != 1
            or not isinstance(value["profiles"], dict)
            or set(value["profiles"]) != set(PROFILE_IDS)):
        return False
    for profile in PROFILE_IDS:
        settings = value["profiles"][profile]
        if (not isinstance(settings, dict)
                or set(settings) != {"max_percent", "cpu_boost", "gpu_boost"}
                or type(settings["max_percent"]) is not int
                or not 30 <= settings["max_percent"] <= 100
                or type(settings["cpu_boost"]) is not bool
                or type(settings["gpu_boost"]) is not bool):
            return False
    return True


def main(argv: list[str]) -> int:
    if len(argv) != 1 or len(argv[0]) > 4096:
        print("Usage: tab-companion-performance-setting '<JSON settings>'", file=sys.stderr)
        return 2
    try:
        value = json.loads(argv[0])
        if not valid_settings(value):
            raise ValueError("expected version 1 and bounded settings for all three profiles")
    except (json.JSONDecodeError, ValueError) as error:
        print(f"Could not save performance settings: {error}", file=sys.stderr)
        return 2

    CONFIG.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".x810-power-profile-tuning.", dir=CONFIG.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(value, stream, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, CONFIG)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print("Saved; the X810 performance service will apply the active profile settings shortly.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
