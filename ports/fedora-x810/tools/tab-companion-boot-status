"""Polkit read-only status adapter for the upstream Tab Companion UI."""
import json
import os
import subprocess
import sys

BACKEND = "/usr/local/libexec/x810-boot-switch-core"
BASE = "/var/lib/x810-boot-sets"


def main():
    try:
        result = subprocess.run([BACKEND, "status"], check=False, text=True,
                                capture_output=True, timeout=180)
        if result.returncode != 0:
            detail = result.stderr.strip() or result.stdout.strip()
            raise RuntimeError(detail or f"boot status backend exited {result.returncode}")
        raw = json.loads(result.stdout)
        sets = []
        for set_id in ("fedora", "android"):
            if set_id not in raw.get("ready", {}):
                continue
            label = "Android" if set_id == "android" else "Fedora"
            try:
                with open(f"{BASE}/{set_id}/name.txt", encoding="utf-8") as f:
                    label = f.readline().strip() or label
            except OSError:
                pass
            sets.append({
                "id": set_id,
                "label": label,
                "complete": bool(raw["ready"].get(set_id)),
                "detail": raw.get("errors", {}).get(set_id),
            })
        st = os.statvfs("/")
        root_total = st.f_blocks * st.f_frsize
        root_free = st.f_bavail * st.f_frsize
        android_total = int(subprocess.check_output(
            ["blockdev", "--getsize64", "/dev/sda34"], text=True).strip())
        print(json.dumps({
            "current": raw.get("current") if raw.get("current") in ("fedora", "android") else None,
            "sets": sets,
            "storage": {
                "ubuntu": {"total": root_total, "used": root_total - root_free, "known": True},
                "android": {"total": android_total, "used": 0, "known": False},
            },
            # This reflects the root-owned polkit rule managed by the app's
            # narrowly scoped helper, not merely helper availability.
            "noask": os.path.exists(
                "/etc/polkit-1/rules.d/49-tab-companion-boot-switch.rules"
            ),
        }))
        return 0
    except Exception as e:
        print(json.dumps({"current": None, "sets": [], "error": str(e)}))
        return 1


if __name__ == "__main__":
    sys.exit(main())
